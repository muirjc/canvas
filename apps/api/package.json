{
  "name": "@canvas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "seed:catalog": "tsx --env-file-if-exists=.env src/seed/catalog.ts",
    "purge": "tsx --env-file-if-exists=.env src/purge/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/openai": "^4.0.20",
    "@canvas/diagram-core": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/session": "^11.0.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "ai": "^7.0.37",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "kysely": "^0.29.6",
    "openid-client": "^6.1.7",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "jose": "^6.2.12",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
