PORT=3000
DATABASE_URL=postgres://canvas:canvas_dev_password@localhost:5433/canvas
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# SSO login is disabled (routes not even registered) when these are left blank -- ALLOW_LOCAL_AUTH
# is then the only way to sign in, and stays the easy default for local dev: unlike the old
# self-hosted Keycloak setup, there's no way to stand up a fully self-contained local IdP with one
# `docker compose` command anymore -- real SSO locally now requires an actual Microsoft Entra ID
# tenant and a "canvas-dev" app registration in it (see RUNBOOK.md's "Entra ID SSO" section for the
# one-time setup steps). To try it locally once you have one, set:
#   OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_CLIENT_ID=<canvas-dev app registration's Application (client) ID>
#   OIDC_CLIENT_SECRET=<canvas-dev app registration's client secret value>
# The issuer MUST end in /v2.0 (not /common, /organizations, /consumers, or a bare tenant path) --
# config.ts fails fast at startup with a clear error otherwise, rather than the opaque
# issuer-mismatch failure openid-client itself would raise several layers deeper.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
ALLOW_LOCAL_AUTH=false
# Comma-separated list of origins allowed to make credentialed (cookie-bearing) requests.
WEB_ORIGINS=http://localhost:5173
# Session cookie attributes. Leave unset for local dev and any same-origin deployment (the
# frontend and API served from one host) — the defaults (no Secure flag, SameSite=Lax) are
# correct there. Set COOKIE_SAME_SITE=none for a split-origin deployment (e.g. a static-hosted
# frontend calling a separately hosted API, as on Azure) — SameSite=Lax cookies are never sent on
# cross-site fetch/XHR calls, only top-level navigation, so a split-origin session silently never
# works without this. COOKIE_SECURE is forced true automatically whenever COOKIE_SAME_SITE=none
# (SameSite=None without Secure is invalid and browsers reject it outright), so it rarely needs
# setting by hand — see docs/azure-deployment.md.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Serves an OpenAPI/Swagger spec + interactive UI at /docs. Opt-in -- left false by default so a
# real deployment doesn't expose its full route surface just because this capability exists.
ENABLE_API_DOCS=false
