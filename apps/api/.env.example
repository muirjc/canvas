PORT=3000
DATABASE_URL=postgres://canvas:canvas_dev_password@localhost:5433/canvas
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# SSO login is disabled (routes not even registered) when these are left blank -- ALLOW_LOCAL_AUTH
# is then the only way to sign in. To try Keycloak SSO locally: `docker compose up -d keycloak`
# (see RUNBOOK.md's "Keycloak SSO" section and infra/keycloak/CanvasRealm-realm.json), then set:
#   OIDC_ISSUER_URL=http://localhost:8180/realms/CanvasRealm
#   OIDC_CLIENT_ID=canvas-api
#   OIDC_CLIENT_SECRET=canvas-dev-client-secret-do-not-use-in-production
# canvas-mi9: openid-client refuses plain-HTTP discovery/token requests by default -- oidc.ts only
# allows it when OIDC_ISSUER_URL's own protocol is http:, which a real deployment's issuer (always
# https://) can never be, so this can't be silently left enabled in production.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# canvas-ycu.1: only set on Azure (infra/azure/modules/apiapp.bicep), where Keycloak has
# internal-only ingress behind canvas-api's own /idp/* reverse proxy (apps/api/src/auth/
# idp-proxy.routes.ts) -- the API calling its own public OIDC_ISSUER_URL for server-side
# discovery/token/userinfo calls doesn't reliably route back to itself within Container Apps'
# network, so these redirect those specific calls straight to Keycloak's real internal FQDN
# instead. A local Keycloak (docker-compose.yml) has no internal/public split -- leave both unset.
OIDC_INTERNAL_ISSUER_URL=
KEYCLOAK_INTERNAL_URL=
ALLOW_LOCAL_AUTH=false
# Comma-separated list of origins allowed to make credentialed (cookie-bearing) requests.
WEB_ORIGINS=http://localhost:5173
# Session cookie attributes. Leave unset for local dev and any same-origin deployment (the
# frontend and API served from one host) — the defaults (no Secure flag, SameSite=Lax) are
# correct there. Set COOKIE_SAME_SITE=none for a split-origin deployment (e.g. a static-hosted
# frontend calling a separately hosted API, as on Azure) — SameSite=Lax cookies are never sent on
# cross-site fetch/XHR calls, only top-level navigation, so a split-origin session silently never
# works without this. COOKIE_SECURE is forced true automatically whenever COOKIE_SAME_SITE=none
# (SameSite=None without Secure is invalid and browsers reject it outright), so it rarely needs
# setting by hand — see docs/azure-deployment.md.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
