# Local settings for the Canvas API (apps/api-py). `npm run dev:local` (repository root) copies this to .env on
# first run and starts everything. Or copy it to .env (gitignored) yourself and pass it in:
#   uv run --env-file .env uvicorn canvas_api.main:app --port 3000 --reload
#   uv run --env-file .env python -m canvas_api.jobs.seed_demo
# The service reads only the process environment, never a .env file on its own.
# Every setting and its default: src/canvas_api/config.py. More in RUNBOOK.md.

# sqlite or postgres. SQLite needs no database server (a file; its folder is created for you; the path is
# relative to apps/api-py, where `npm run dev:local` and the commands above run). One writer at a time:
# fine for local use and small teams, see RUNBOOK.md "Database engine".
DB_CLIENT=sqlite
DATABASE_URL=./data/canvas.db
# PostgreSQL instead: the docker compose database on host port 5433 (`docker compose up -d`), or any Postgres 16.
# DB_CLIENT=postgres
# DATABASE_URL=postgres://canvas:canvas_dev_password@localhost:5433/canvas

# At least 32 characters. Any value works locally; use a random one anywhere else.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# SESSION_IDLE_MINUTES=480
# SESSION_MAX_HOURS=12

# Sign-in. entra (default) or local (Canvas-managed accounts only; see RUNBOOK.md "Local accounts").
AUTH_MODE=entra
# true = email + password sign-in alongside Entra: the demo logins seed_demo prints.
ALLOW_LOCAL_AUTH=true
# LOGIN_RATE_LIMIT=20
# MFA_REQUIRED=false
# MFA_ENCRYPTION_KEY=   # base64 of 32 bytes (openssl rand -base64 32); derived from SESSION_SECRET if unset

# Entra ID SSO is off while these are blank. To try it, see RUNBOOK.md "Entra ID SSO".
# The issuer must end in /v2.0 (not /common, /organizations or /consumers).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Origins allowed to make credentialed (cookie) requests: the Vite dev server.
WEB_ORIGINS=http://localhost:5173
# Defaults suit local dev and any same-origin deployment.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# AI chat: anthropic, openai or mock (rule-based, no key, what the e2e suite uses). Unset = AI off.
AI_PROVIDER=mock
# AI_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# GitHub approval: off unless both are set. Use a test App on a sandbox repository.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # the PEM, or base64 of it
# CANVAS_PUBLIC_URL=http://localhost:5173

# Telemetry to Application Insights: off unless set.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# true = FastAPI's Swagger UI at /docs and the OpenAPI JSON at /openapi.json.
ENABLE_API_DOCS=false

# canvas-2h2w.3: share with Entra groups assigned to the Canvas app (Entra sign-in only; RUNBOOK "Entra groups").
# ENTRA_GROUPS=true
