// canvas-ez1.3: creates the first admin of an AUTH_MODE=local environment (no seeded accounts
// there -- the demo seed's passwords are published). Runs apps/api/src/seed/bootstrap-admin.ts:
// creates the admin with a one-time password from Key Vault (generated by deploy.sh into
// infra/azure/.secrets/), or leaves an existing account alone. Only deployed in local mode;
// deploy.sh starts it after migrations on every local-mode deploy, and reset-admin.sh runs it in
// reset mode to recover a lone admin who can't sign in.

@description('Azure region.')
param location string

@description('Container Apps environment resource ID.')
param environmentId string

@description('User-assigned managed identity resource ID.')
param identityId string

@description('ACR login server.')
param acrLoginServer string

@description('Tag of the API image -- the same image the API app runs; only the command differs.')
param apiImageTag string

@description('Key Vault URI.')
param keyVaultUri string

@description('The first admin\'s email (deploy.sh: CANVAS_ADMIN_EMAIL, cached in .secrets/admin-email).')
param adminEmail string

resource catalogSeedJob 'Microsoft.App/jobs@2025-01-01' = {
  name: 'canvas-bootstrap-admin'
  location: location
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${identityId}': {}
    }
  }
  properties: {
    environmentId: environmentId
    configuration: {
      triggerType: 'Manual'
      replicaTimeout: 300
      replicaRetryLimit: 0
      manualTriggerConfig: {
        replicaCompletionCount: 1
        parallelism: 1
      }
      registries: [
        {
          server: acrLoginServer
          identity: identityId
        }
      ]
      secrets: [
        {
          name: 'database-url'
          keyVaultUrl: '${keyVaultUri}secrets/database-url'
          identity: identityId
        }
        {
          name: 'session-secret'
          keyVaultUrl: '${keyVaultUri}secrets/session-secret'
          identity: identityId
        }
        {
          // Generated by deploy.sh into infra/azure/.secrets/bootstrap-admin-password.
          name: 'bootstrap-admin-password'
          keyVaultUrl: '${keyVaultUri}secrets/bootstrap-admin-password'
          identity: identityId
        }
      ]
    }
    template: {
      containers: [
        {
          name: 'bootstrap-admin'
          image: '${acrLoginServer}/canvas-api:${apiImageTag}'
          command: ['node']
          args: ['apps/api/dist/seed/bootstrap-admin.js']
          env: [
            { name: 'DATABASE_URL', secretRef: 'database-url' }
            // runMigrations() -> loadConfig() requires it, as in migrationjob.bicep.
            { name: 'SESSION_SECRET', secretRef: 'session-secret' }
            // No AUTH_MODE here: with AUTH_MODE=local in production, loadConfig() demands
            // MFA_ENCRYPTION_KEY, which this job doesn't use (found on the first live deploy).
            { name: 'BOOTSTRAP_ADMIN_EMAIL', value: adminEmail }
            { name: 'BOOTSTRAP_ADMIN_PASSWORD', secretRef: 'bootstrap-admin-password' }
            // 'create' leaves an existing account alone; reset-admin.sh flips this to 'reset' for
            // one execution to recover a locked-out lone admin.
            { name: 'BOOTSTRAP_MODE', value: 'create' }
          ]
          resources: {
            cpu: json('0.5')
            memory: '1Gi'
          }
        }
      ]
    }
  }
}

output jobName string = catalogSeedJob.name
