flowchart TD
subgraph grp [Group]
  g1[Inside]:::step
end
  s([Start]):::start
  a[Validate]:::step
  b(Approve):::step
  c[Reject]:::step
  d{OK?}:::decision
  s2((Again)):::start
  db[(Orders)]:::store
  x[Loose]:::primary_activity
  y[Thing]:::mystery
  hex{{Hexagon}}
  s --> a
  a --> b
  a --> c
  b -.-> c
  d -->|yes| a
  d --> b
  d -->|no| c
  s2 <--> a
  a -.->|save| db
  b --> db
  x --> y
