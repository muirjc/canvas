---
canvas:
  styles:
    s:
      fillColor: "#dcfce7"
      strokeColor: "#166534"
      fontFamily: Arial
      fontSize: 8
    a:
      fillColor: "#F1F5F9"
      fontSize: 24
      fontFamily: Inter
    db:
      fillColor: "#FEF3C7"
      strokeColor: "#b45309"
---
flowchart TD
  s([Start]):::start --> a[Validate]:::step
  a --> b(Approve):::step
  a --> c[Reject]:::step
  b -.-> c
  d{OK?}:::decision -->|yes| a
  d --> b
  d -- no --> c
  s2((Again)):::start
  s2 <--> a
  db[(Orders)]:::store
  a -.->|save| db
  b --> db
  x[Loose]
  y[Thing]:::mystery
  x --> y
  subgraph grp [Group]
    g1[Inside]:::step
  end
  hex{{Hexagon}}
  linkStyle 1 stroke:#ff0000
  linkStyle 3 stroke:#333333
  style d fill:#dbeafe
  class x primary_activity
