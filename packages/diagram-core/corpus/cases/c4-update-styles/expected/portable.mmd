UpdateElementStyle(a, $bgColor="#ff0000", $borderColor="#000000")
UpdateElementStyle(b, $bgColor="grey", $borderColor="black")
UpdateElementStyle(c, $bgColor="a, b")
UpdateRelStyle(a, b, $lineColor="blue")
