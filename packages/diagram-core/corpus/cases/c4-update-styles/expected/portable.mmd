C4Context
  System(a, "A")
  System(b, "B")
  System(c, "C")
  Rel(a, b, "ab")
  Rel(a, b, "ab again")
  Rel(b, c, "bc")
  UpdateElementStyle(a, "#ff0000", "#ffffff", "#000000")
  UpdateElementStyle(b, $fontColor="red", $bgColor="grey", $borderColor="black")
  UpdateElementStyle(c, $bgColor="a, b")
  UpdateElementStyle(missing, $bgColor="red")
  UpdateRelStyle(a, b, "red", "blue", "-40", "60")
  UpdateRelStyle(b, c, $textColor="red", $offsetY="-40")
  UpdateRelStyle(c, a, $lineColor="green")
  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
