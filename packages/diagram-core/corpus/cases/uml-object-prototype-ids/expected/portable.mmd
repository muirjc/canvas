classDiagram
  class constructor {
    +String toString
    +valueOf() int
  }
  namespace toString {
    class __proto__
  }
  constructor <|-- hasOwnProperty
  <<interface>> hasOwnProperty
  note for constructor "a note"
  style __proto__ fill:#ff0000
  style valueOf fill:#00ff00
  classDef isPrototypeOf fill:#0000ff
  class hasOwnProperty isPrototypeOf
  class constructor toString
%% Colours for Mermaid tools outside Canvas (added on export).
style __proto__ fill:#ff0000
style hasOwnProperty fill:#0000ff
