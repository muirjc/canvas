C4Component
  title Canvas API: components
  Container(web, "Web app", "React", "The browser client")
  ContainerDb(db, "Database", "PostgreSQL / SQLite")
  Container_Boundary(api, "API (apps/api-py)") {
    Component(frontdoor, "Front door", "FastAPI middleware", "Serves the built web app, security headers, CORS, paused page")
    Component(auth, "Auth", "routes/auth.py, auth/", "Sessions, Canvas accounts with two-step verification, Entra OIDC, groups")
    Component(access, "Access", "access.py", "Highest of view-for-all, project, share and ownership levels")
    Component(diagrams, "Diagrams", "routes/diagrams.py", "Create, save with compare-and-set, versions, presence, import")
    Component(standards, "Standards", "routes/standards.py", "Versions, publish, retire, re-check diagrams")
    Component(sharing, "Sharing", "routes/sharing.py", "Members, shares, groups, ownership, notifications")
    Component(comments, "Comments", "routes/comments.py", "Threads anchored to elements")
    Component(ai, "AI chat", "ai/", "Tool loop over diagram-core edits, personas, usage")
    Component(githubc, "GitHub", "github/", "Links, submissions, status sync")
    Component(export, "Export", "routes/export.py", "Mermaid, SVG, PNG (resvg)")
    Component(core, "diagram-core", "diagram_core/", "Parse, serialize, validate, render, Auto Layout")
    Component(telemetry, "Telemetry", "telemetry/", "OpenTelemetry spans per request and query")
  }
  Rel(web, frontdoor, "HTTPS")
  Rel(frontdoor, auth, "Routes requests")
  Rel(diagrams, access, "Checks access")
  Rel(sharing, access, "Checks access")
  Rel(diagrams, core, "Parses and validates")
  Rel(standards, core, "Checks definitions")
  Rel(ai, core, "Applies tool calls")
  Rel(export, core, "Renders")
  Rel(githubc, core, "Renders submission files")
  Rel(diagrams, db, "SQL")
  Rel(auth, db, "Sessions, accounts")
